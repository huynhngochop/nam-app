{
  "expo": {
    "name": "Thành Tâm",
    "slug": "thanh-tam",
    "scheme": "thanhtam",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "vn.namapp.thanhtam"
    },
    "android": {
      "package": "vn.namapp.thanhtam",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6e3b1f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "allowBackup": true
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6e3b1f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#1a1410"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6e3b1f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
