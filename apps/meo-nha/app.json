{
  "expo": {
    "name": "Mẹo Nhà",
    "slug": "meo-nha",
    "scheme": "meonha",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.namapp.meonha"
    },
    "android": {
      "versionCode": 2,
      "package": "vn.namapp.meonha",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#a64a22"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#a64a22",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#141311"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#a64a22"
        }
      ],
      "../../packages/core/plugins/with-android-release"
    ],
    "experiments": {
      "typedRoutes": true
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511",
    "delay_app_measurement_init": true,
    "user_tracking_usage_description": "Cho phép để quảng cáo phù hợp hơn với bạn. Bạn vẫn dùng app đầy đủ nếu không cho phép.",
    "sk_ad_network_items": [
      "cstr6suwn9.skadnetwork"
    ]
  }
}
