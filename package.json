{
  "name": "nam-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:stubs": "tsc -p tests/tsconfig.typecheck.json",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "meo": "npm --workspace @nam/meo-nha run start",
    "nhip": "npm --workspace @nam/nhip run start",
    "hen": "npm --workspace @nam/hen-dep run start",
    "vi": "npm --workspace @nam/vi-gon run start"
  },
  "dependencies": {
    "expo-asset": "~12.0.14"
  },
  "devDependencies": {
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
