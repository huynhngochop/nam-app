{
  "expo": {
    "name": "Lên Band",
    "slug": "len-band",
    "scheme": "lenband",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.namapp.lenband",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lên Band cần micro để ghi câu trả lời của bạn và chấm phần nói IELTS."
      }
    },
    "android": {
      "package": "vn.namapp.lenband",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3043b8"
      },
      "permissions": ["android.permission.RECORD_AUDIO"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3043b8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0f1626"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3043b8"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Lên Band cần micro để ghi câu trả lời của bạn và chấm phần nói IELTS."
        }
      ],
      "../../packages/core/plugins/with-android-release"
    ],
    "experiments": {
      "typedRoutes": true
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511",
    "delay_app_measurement_init": true,
    "user_tracking_usage_description": "Cho phép để quảng cáo phù hợp hơn với bạn. Bạn vẫn dùng app đầy đủ nếu không cho phép.",
    "sk_ad_network_items": [
      "cstr6suwn9.skadnetwork"
    ]
  }
}
